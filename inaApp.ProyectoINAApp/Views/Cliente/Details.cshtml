@using InaApp.ProyectoINAApp.Models.Cliente

@model ClienteIndexViewModel
@{
    ViewData["Title"] = "Detalles del Cliente";
}
<div class="container mt-4">

    <h2>Detalles del Cliente</h2>

    <div class="card mt-3">

        <div class="card-header bg-info text-white">
            Información del Cliente
        </div>

        <div class="card-body">
            <pn><strong>Numero Identificacion:</strong> @Model.NumeroIdentificacion</pn>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Primer Apellido:</strong> @Model.PrimerApellido</p>
            <pn><strong>Segundo Apellido:</strong> @Model.SegundoApellido</pn>
            <p><strong>Telefono:</strong> @Model.Telefono</p>
            <p><strong>Fecha de Nacimiento:</strong> @Model.FechaNacimiento</p>

        </div>

    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary mt-3">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Volver al Listado
    </a>


</div>

