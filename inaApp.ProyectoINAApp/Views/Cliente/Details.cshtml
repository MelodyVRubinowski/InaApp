@using InaApp.ProyectoInaApp.Models.Cliente


@model ClienteIndexViewModel
@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container mt-4">

    <h2>Detalles del Producto</h2>
    
    <div class="card mt-3">
    
        <div class="card-header bg-info text-white">
            Información del Producto
        </div>
        
        <div class="card-body">
            <pn><strong>Id:</strong> @Model.NumeroIdentificacion</pn>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Apellido:</strong> @Model.PrimerApellido</p>


            </div>

    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary mt-3">
        Editar
    </a>
        
    <a asp-action="Index" class="btn btn-secondary mt-3">
        Volver al Listado
    </a>


</div>


