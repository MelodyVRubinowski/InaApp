@using InaApp.ProyectoInaApp.Models.Cliente


@model ClienteEditViewModel
@{
    ViewData["Title"] = "Editar Cliente";
}


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Editar Cliente</h4>
                </div>
                <div class="card-body">

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <h5 class="text-secondary mb-3">Información de Identificación</h5>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="TipoIdentificacion" class="form-label"></label>
                                <select asp-for="TipoIdentificacion"
                                        asp-items="ViewBag.TiposIdentificacion"
                                        class="form-select">
                                    <option value="">-- Seleccione --</option>
                                </select>
                                <span asp-validation-for="TipoIdentificacion" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="NumeroIdentificacion" class="form-label"></label>
                                <input asp-for="NumeroIdentificacion" class="form-control" placeholder="Ej: 123456789" />
                                <span asp-validation-for="NumeroIdentificacion" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <h5 class="text-secondary mb-3">Datos Personales</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PrimerApellido" class="form-label"></label>
                                <input asp-for="PrimerApellido" class="form-control" />
                                <span asp-validation-for="PrimerApellido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="SegundoApellido" class="form-label"></label>
                                <input asp-for="SegundoApellido" class="form-control" />
                                <small class="text-muted">Opcional</small>
                                <span asp-validation-for="SegundoApellido" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <h5 class="text-secondary mb-3">Información de Contacto</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Correo" class="form-label"></label>
                                <input asp-for="Correo" type="email" class="form-control" />
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label"></label>
                                <input asp-for="Telefono" type="tel" class="form-control" />
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning text-dark">
                                <i class="bi bi-pencil-square"></i> Actualizar Cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}