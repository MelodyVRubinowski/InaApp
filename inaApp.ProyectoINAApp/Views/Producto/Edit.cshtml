@using inaApp.ProyectoINAApp.Models.Producto


@model ProductoEditViewModel
@{
    ViewData["Title"] = "Modificar Producto";
}


<div class="container mt-4">

    <h2>Modificar Producto</h2>

    <form asp-action="Edit" method="post">
       <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

       <input asp-for="Id" type="hidden" />
       
        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" class="form-select" asp-items="@Model.Categorias"></select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" class="form-control" type="number" step="0.01"/>
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success mt-3">
            Guardar cambios
        </button>

        <a asp-action="Index" class="btn btn-secondary mt-3">
            Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}