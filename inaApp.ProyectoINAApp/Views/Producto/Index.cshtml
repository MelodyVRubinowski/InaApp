@using inaApp.ProyectoINAApp.Models.Producto



@model List<ProductoIndexViewModel>

@{
    ViewData["Title"] = "Productos";
}


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Productos</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nuevo Producto
        </a>
    </div>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Categoria</th>
            <!-- Nuevos encabezados requeridos -->
            <th>Impuesto</th>
            <th>% Imp.</th>
            <th>% Desc. Máx.</th>
            <th>Precio</th>
            <th>Stock</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Id</td>
                    <td>@producto.Nombre</td>
                    <td>@producto.CategoriaNombre</td>
                    <!-- Nuevas celdas con la información requerida -->
                    <td>@producto.ImpuestoAplicable</td>
                    <td>@producto.PorcentajeImpuesto%</td>
                    <td>@producto.DescuentoMaximoPermitido%</td>
                    <td>₡@producto.Precio.ToString("N2")</td>
                    <td>@producto.Stock</td>
                        <td class="text-center">
                            <a asp-action="Details"
                               asp-route-id="@producto.Id"
                               class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@producto.Id"
                               class="btn btn-warning btn-sm">
                                Modificar
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@producto.Id"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        </td>
                    </tr>
            }
        }
        else
        {
            <!-- Actualiza el colspan a 9 para que cubra las nuevas columnas -->
            <tr>
                <td colspan="9" class="text-center">
                    No existen productos registrados.
                </td>
            </tr>
        }
    </tbody>
</table>