@using inaApp.ProyectoINAApp.Models.Producto
@model ProductoCreateViewModel

@{
    ViewData["Title"] = "Crear Producto";
}

<h2>Crear Producto</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" class="form-select" asp-items="@Model.Categorias"></select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <!-- NUEVOS CAMPOS REQUERIDOS POR LA ACTIVIDAD -->
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ImpuestoAplicable" class="form-label"></label>
            <input asp-for="ImpuestoAplicable" class="form-control" placeholder="Ej: IVA" />
            <span asp-validation-for="ImpuestoAplicable" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="PorcentajeImpuesto" class="form-label"></label>
            <div class="input-group">
                <input asp-for="PorcentajeImpuesto" class="form-control" type="number" step="0.01" />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="PorcentajeImpuesto" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="DescuentoMaximoPermitido" class="form-label"></label>
            <div class="input-group">
                <input asp-for="DescuentoMaximoPermitido" class="form-control" type="number" step="0.01" />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="DescuentoMaximoPermitido" class="text-danger"></span>
        </div>
    </div>
    <!-- FIN DE CAMPOS NUEVOS -->

    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="bi bi-save"></i> Guardar Producto
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}