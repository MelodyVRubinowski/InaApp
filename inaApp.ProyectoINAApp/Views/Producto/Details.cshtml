@using inaApp.ProyectoINAApp.Models.Producto
@model ProductoIndexViewModel

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container mt-4">

    <h2>Detalles del Producto</h2>

    <div class="card mt-3">

        <div class="card-header bg-info text-white">
            Información del Producto
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Id:</strong> @Model.Id</p>
                    <p><strong>Nombre:</strong> @Model.Nombre</p>
                    <p><strong>Categoría:</strong> @Model.CategoriaNombre</p>
                    <p><strong>Precio:</strong> ₡@Model.Precio.ToString("N2")</p>
                    <p><strong>Stock (Existencias):</strong> @Model.Stock</p>
                </div>
                <div class="col-md-6">
                    <!-- NUEVOS CAMPOS REQUERIDOS POR EL REQUERIMIENTO 2 -->
                    <p><strong>Impuesto Aplicable:</strong> @Model.ImpuestoAplicable</p>
                    <p><strong>Porcentaje de Impuesto:</strong> @Model.PorcentajeImpuesto.ToString("N2")%</p>
                    <p><strong>Descuento Máximo Permitido:</strong> @Model.DescuentoMaximoPermitido.ToString("N2")%</p>
                    <!-- FIN DE CAMPOS NUEVOS -->
                    <p><strong>Descripción:</strong> @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</p>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Editar
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Volver al Listado
        </a>
    </div>

</div>