@model inaApp.ProyectoINAApp.Models.Factura.FacturaEditViewModel
@{
    ViewData["Title"] = "Eliminar Factura";
}

<div class="container">
    <h2 class="text-danger">¿Está seguro de que desea anular esta factura?</h2>
    <div class="alert alert-warning">
        Esta acción es irreversible y podría afectar el stock de los productos.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <p><strong>Número:</strong> @Model.NumeroFactura</p>
            <p><strong>Cliente:</strong> @Model.ClienteNombre</p>
            <p><strong>Total:</strong> @Model.Total.ToString("C")</p>
        </div>
    </div>

    <form asp-action="AnularConfirmed">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger btn-lg">Sí, Anular Factura</button>
        <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
    </form>
</div>