@using inaApp.ProyectoINAApp.Models.Cliente

@model List<ClienteIndexViewModel>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Clientes</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Nuevo Cliente
        </a>
    </div>


    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre Completo</th>
                        <th>Tipo Identificación</th>
                        <th>Correo Electrónico</th>
                        <th>Teléfono</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cliente in Model)
                        {
                            <tr>
                                <td class="font-monospace">@cliente.NumeroIdentificacion</td>
                                <td>@cliente.NombreCompleto</td> 
                                <td>@cliente.TipoIdentificacion</td> 
                                <td>
                                    @if (!string.IsNullOrEmpty(cliente.CorreoElectronico))
                                    {
                                        <a href="mailto:@cliente.CorreoElectronico" class="text-decoration-none text-primary">@cliente.CorreoElectronico</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(cliente.Telefono))
                                    {
                                        <a href="tel:@cliente.Telefono" class="text-decoration-none text-primary">@cliente.Telefono</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                   
                                    <a asp-action="Details" asp-route-id="@cliente.NumeroIdentificacion" class="btn btn-info btn-sm" title="Ver detalles">
                                        <i class="bi bi-eye-fill"></i> Ver
                                    </a>

                                 
                                    <a asp-action="Edit" asp-route-id="@cliente.NumeroIdentificacion" class="btn btn-warning btn-sm text-dark" title="Editar cliente">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>

                                  
                                    <a asp-action="Delete" asp-route-id="@cliente.NumeroIdentificacion" class="btn btn-danger btn-sm" title="Eliminar cliente">
                                        <i class="bi bi-trash-fill"></i> Borrar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-exclamation-circle-fill me-2"></i>
                                No existen clientes registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>