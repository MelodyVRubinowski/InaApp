@using inaApp.Web.ViewModels.Factura
@model FacturaCreateViewModel

<h2>Registrar Nueva Venta</h2>

<form asp-action="Create" id="formFactura">
    <!-- SECCIÓN MAESTRO: Información General -->
    <div class="card mb-3">
        <div class="card-header bg-dark text-white">Datos de la Factura</div>
        <div class="card-body row">
            <div class="col-md-4">
                <label>Número de Factura</label>
                <input asp-for="NumeroFactura" class="form-control" placeholder="Ej: F001-0001" />
            </div>
            <div class="col-md-4">
                <label>Fecha</label>
                <input asp-for="Fecha" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
  
            </div>
        </div>
    </div>

    <!-- SECCIÓN DETALLE: Selección de Productos -->
    <div class="card mb-3">
        <div class="card-header bg-secondary text-white">Agregar Productos</div>
        <div class="card-body row">
            <div class="col-md-5">
                <label>Producto</label>
                <select id="selProducto" asp-items="Model.Productos" class="form-control"></select>
            </div>
            <div class="col-md-3">
                <label>Cantidad</label>
                <input type="number" id="txtCantidad" class="form-control" min="1" value="1" />
            </div>
            <div class="col-md-4">
                <button type="button" onclick="agregarProducto()" class="btn btn-success mt-4">Agregar al Detalle</button>
            </div>
        </div>
    </div>

    <!-- TABLA TEMPORAL: Productos agregados antes de guardar -->
    <table class="table table-bordered" id="tablaDetalles">
        <thead class="thead-light">
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Subtotal</th>
                <th>Impuesto</th>
                <th>Total</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody id="detallesBody">
            <!-- Filas dinámicas aquí -->
        </tbody>
    </table>

    <!-- RESUMEN: Totales calculados -->
    <div class="row justify-content-end">
        <div class="col-md-3 text-right">
            <p>Subtotal: <span id="lblSubtotal">$0.00</span></p>
            <p>Impuesto: <span id="lblImpuesto">$0.00</span></p>
            <p>Descuento: <input asp-for="Descuento" id="txtDescuento" class="form-control d-inline w-50" value="0" onchange="recalcularTotales()" /></p>
            <h4>Total Final: <span id="lblTotal">$0.00</span></h4>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-lg">Confirmar y Guardar Factura</button>
        <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        // Lógica simple para manejar la tabla temporal en el cliente
        let detalles = [];

        function agregarProducto() {
            const select = document.getElementById("selProducto");
            const productoId = select.value;
            const productoNombre = select.options[select.selectedIndex].text;
            const cantidad = parseInt(document.getElementById("txtCantidad").value);

            // Aquí deberías obtener el precio real vía AJAX o desde un atributo data en el select
            const precio = 100.00; // Valor ejemplo para la demostración UI

            if (productoId && cantidad > 0) {
                detalles.push({ productoId, productoNombre, cantidad, precio });
                renderizarTabla();
            }
        }

        function renderizarTabla() {
            const body = document.getElementById("detallesBody");
            body.innerHTML = "";
            let subtotalGral = 0;

            detalles.forEach((item, index) => {
                const subLinea = item.cantidad * item.precio;
                subtotalGral += subLinea;
                body.innerHTML += `
                    <tr>
                        <td>${item.productoNombre} <input type="hidden" name="Detalles[${index}].ProductoId" value="${item.productoId}" /></td>
                        <td>${item.cantidad} <input type="hidden" name="Detalles[${index}].Cantidad" value="${item.cantidad}" /></td>
                        <td>${item.precio}</td>
                        <td>${subLinea}</td>
                        <td>${subLinea * 0.15}</td> <!-- Ejemplo IVA 15% -->
                        <td>${subLinea * 1.15}</td>
                        <td><button type="button" class="btn btn-danger btn-sm" onclick="eliminar(${index})">Eliminar</button></td>
                    </tr>`;
            });
            // Nota: Los cálculos finales reales los hace el Service [6]
        }
    </script>
}